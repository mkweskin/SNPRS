profiles {
    standard {
        params.runProfile = 'standard'

        process {
            executor = 'local'

            // Default max concurrent processes
            maxForks = 10
            memory = 8.GB

            //speicfy fewer processes for some tasks because of memory
            withName: 'CALL_BASES' {
                maxForks = 5
            }

            withName: 'POPULATE_MATRIX' {
                maxForks = 3
            }
        }

        conda.enabled = true
        conda.useMicromamba = true
        conda.cacheDir = "${projectDir}/SNPRS_Env"
        process.conda = "${projectDir}/conf/SNPRS.yaml"

        params.cpus = 1
        params.sample_cpus = 2
        params.nodes = 1
        params.mem_mode = true
    }

    local {
        params.runProfile = 'local'
        process.executor = 'local'
        conda.enabled = true
        conda.cacheDir = "${projectDir}/SNPRS_Env"
        process.conda = "${projectDir}/conf/SNPRS.yaml"
        
        process.maxForks = 1
        params.cpus = 8
        params.sample_cpus = 8
        params.nodes = 1
        params.mem_mode = true
    }

    slurm {
        params.runProfile = 'slurm'
        process.executor = 'slurm'
        conda.enabled = true
        conda.useMicromamba = true
        conda.cacheDir = "${projectDir}/SNPRS_Env"
        process.conda = "${projectDir}/conf/SNPRS.yaml"

        params.cpus = 48
        params.sample_cpus = 24
        params.nodes = 3

        executor.queueSize = 1000
        params.ray_module = "ray/2.3.1"
    }
}
