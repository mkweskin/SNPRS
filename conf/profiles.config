profiles {
    standard {
        params.runProfile = 'standard'
        process.executor = 'local'
        conda.enabled = true
        conda.useMicromamba = true
        conda.cacheDir = "${projectDir}/SNPRS_Env"
        process.conda = "${projectDir}/conf/SNPRS.yaml"
        
        process.maxForks = 1
        params.cpus = 1
        params.sample_cpus = 1
        params.nodes = 1
        params.mem_mode = true

    }
    local {
        params.runProfile = 'local'
        process.executor = 'local'
        conda.enabled = true
        conda.cacheDir = "${projectDir}/SNPRS_Env"
        process.conda = "${projectDir}/conf/SNPRS.yaml"
        
        process.maxForks = 1
        params.cpus = 8
        params.sample_cpus = 8
        params.nodes = 1
        params.mem_mode = true
    }

    slurm {
        params.runProfile = 'slurm'
        process.executor = 'slurm'
        conda.enabled = true
        conda.useMicromamba = true
        conda.cacheDir = "${projectDir}/SNPRS_Env"
        process.conda = "${projectDir}/conf/SNPRS.yaml"

        params.cpus = 48
        params.sample_cpus = 24
        params.nodes = 3

        executor.queueSize = 1000
        params.ray_module = "ray/2.3.1"
    }
}
