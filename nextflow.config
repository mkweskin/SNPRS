/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SNPRS Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Import profile settings
includeConfig "${projectDir}/conf/profiles.config"

// Global default params

params {
    
    ///// Output Parameters /////
    
    timestamp = "${new java.util.Date().getTime()}"         // Timestamp to use in the event of blanks
    out = false                                             // Overall output directory
    overwrite = false                                       // If output files exist, replace them. WARNING: --overwrite is GREEDY and will delete whatever you tell it to. You've been warned.

    ///// Local/Memory-Mode /////

    local = false                                           // In 'local' mode, some Polars-heavy steps cannot proceed until previous steps have completed
    mem_factor = 1                                          // Set to larger int for smaller chunks; Chunk size for processing large dataframes will be set to CPU count *mem_factor 

    ///// Filetype Defaults /////

    read_ext = "fastq.gz"
    forward = "_1.fastq.gz"
    reverse = "_2.fastq.gz"

    ///// Pangenome Assembly /////
    
    ray_module = false                                      // Module name for Ray
    pg_reads = false                                        // Path to directory containing reads or nested dirs for pangenome assembly
    genome_name = false                                     // Genome ID
    size = false                                            // Approximate size of genome for the group in basepairs (bp)
    coverage = 10                                           // Desired read coverage for assembly
    kmer = 31                                               // kmer value for Ray assembly
    out_prop = 0.15                                         // Proportion of reads to take from outgroups, if present
    min_contig = 1                                          // Minimum contig size to retain in final pangenome
    manual_counts = false                                   // Path to CSV with header: Sample_ID', 'Group_0', 'Group_1', 'Base_Count', 'Forward_Read', 'Reverse_Read'

    ///// Other Genome Options /////
    
    fasta = false                                           // Path to existing FASTA file to use as a reference (can be renamed via --genome_name)
    genome_dir = false                                      // Path to directory containing a FASTA and associated SNPRS index information
    no_ref = false                                          // Do not attempt to load in a reference genome    

    ///// Read Mapping /////

    map_reads = false                                       // Path to a folder containing reads or a text file with path(s) to read-containing directories to map onto the reference
    slow = false                                            // Run BBMap in slow mode
    vslow = false                                           // Run BBMap in vslow mode (overrides slow)

    bam_files = false                                       // Path to a folder containing BAMs or a text file with path(s) to BAM files

    ///// Bam-to-Parquet Settings /////

    mapq = 15                                               // Minimum mapping quality (MAPQ) for mpileup -q [Default: 15]
    baseq = 15                                              // Minimum base quality (BASEQ) for mpileup -Q [Default: 15]
    adj_coef = 50                                           // Adjustment coefficient for mpileup -C [Default: 50]

    raw_parquets = false                                    // Path to a folder containing *_Raw.parquet files or a text file with path(s) to files ending in '_Raw.parquet'
    delete_bam = false                                      // Delete BAM/bai files after converting to parquet

    ///// Base Calling Settings /////

    ploidy = 0                                              // Sample ploidy; Starts base calling; Reject sites with more than <ploidy> alleles occurring at or above 'min_freq'; Set to 5 for mixed samples (No ploidy limit)

    min_depth = 1                                           // Minimum read coverage to consider a site
    min_allele = 1                                          // Minimum read coverage to consider an allele (overrides min_read)
    min_freq = 0.15                                         // Minimum allele frequency to call a secondary allele

    called_bases = false                                    // Path to a folder containing *_Called.parquet files or a text file with path(s) to files ending in '_Called.parquet'

    ///// Join Settings /////

    join_id = false                                         // Join all called bases into a joined dataset called <join_id>
    scaffold = false                                        // Path to premade SNPRS scaffold file (must contain contig_index,contig_position)
    chunk_size = 1                                          // Number of called base parquets to process per chunk


    join_csv = false                                        // Path to CSV file with join information (Join_ID,Sample_ID,Called_Base_Parquet)
    joined = false                                          // Path to joined JSON file or path to a text file with path(s) to joined JSON files


    ///// Filter Settings /////

    filter_id = false                                       // Filter joined bases into a subdataset of join called <filter_id>

    min_cov = false                                         // If 0 or > 1, number of samples with coverage required. If between 0 - 1, proportion of samples with coverage required to keep a site. 
    min_fix = false                                         // If 0 or > 1, number of samples with fixed coverage required. If between 0 - 1, proportion of samples with fixed coverage required to keep a site. 
    min_het = false                                         // If 0 or > 1, number of samples with heterzygous coverage required. If between 0 - 1, proportion of heterozygous samples with coverage required to keep a site. 
    max_pf = false                                          // If 0 or > 1, maximum number of samples with ploidy failures allowed. If between 0 - 1, proportion of samples with ploidy failure allowed 
    min_clade = false                                       // If set, the minimum size of the second largest split (i.e., Only return sites that separate at least X samples)
    
    alleles = '2,3,4,5'                                     // Comma-separated list of unique allele counts requested [Default: '2,3,4,5']
    
    no_gaps = false                                         // If flagged, remove sites where any sample has '-' [Default: Keep sites with indels]
    no_sing = false                                         // If flagged, remove sites where any sample is a singleton [Default: Allow singletons if other criteria are met; Overridden if s/S or u/U included in site_types]
    no_het = false                                          // If flagged, remove sites where any sample has a heterzygous call [Default: Keep sites with heterozgotes]
  
    ///// Distance Settings /////
    dist_id = false                                         // Get distances for isolates from int_dir
    raw = false                                             // Report raw SNP distances   
   
    ///// Group Settings /////

    terminal_id = false                                     // Filter joined bases into a terminal dataset called <terminal_id>
    outgroup_id = false                                     // 

    ///// Trees + Alignments /////

    alignment = false                                       // Create an alignment file from filtered data 
    tree = false                                            // Create a tree from filtered alignment

    fast = false                                            // Use FastTree instead of iqTree
    gtr = false                                             // Use GTR+G for iqtree [Default: MFP+MERGE]
    bb = 1000                                               // Ultrafast bootstrap replicates [Default: 1000]

    alignment_file = false                                  // Path to an alignment file
    tree_file = false                                       // Path to a newick/nexus file to use in tree functions

    ///// SNP Analysis /////
    
    snp_id = false                                          // Prefix for SNP files; Set to generate SNPs

    terminal = false                                        // Path to terminal JSON file or path to a text file with path(s) to terminal JSON files
    internal = false                                        // Path to internal JSON file or path to a text file with path(s) to internal JSON files
    outgroup = false                                        // Path to terminal JSON file for outgroup 
    
    snp_json = false                                        // Path to JSON file for a SNPRS SNP datasets
}