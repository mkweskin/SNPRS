/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SNPRS Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Import profile settings
includeConfig "${projectDir}/conf/profiles.config"

//process {
//  conda.enabled = true
//  conda.useMicromamba = true
//  conda.cacheDir = "${projectDir}/SNPRS_env"
//  process.conda = "${projectDir}/conf/SNPRS.yaml"    
//}

// Global default params
params {
    
    ///// Output Parameters /////
    runProfile = "standard"                                 // String for profile
    mem_mode = false                                        // In memory mode, where possible streaming steps are replaced with temporary files to reduce memory usage. Run times will longer with --mem_mode set.                                      
    timestamp = "${new java.util.Date().getTime()}"         // Timestamp to use in the event of blanks
    out = false                                             // Overall output directory
    overwrite = false                                       // If output files exist, replace them. WARNING: --overwrite is GREEDY and will delete whatever you tell it to. You've been warned.

    ///// CPUs/Nodes /////
    cpus = 1                                                // Number of available CPUs per node
    sample_cpus = false                                     // Number of available CPUs allotted to each sample for sample-specific processes (Default: params.cpus)
    nodes = 1                                               // Number of available nodes (only required for Ray)

    ///// Input Data /////
    
    pg_reads = false                                        // Path to directory containing reads or nested dirs for pangenome assembly (forces pangenome assembly, overrides --fasta)
    fasta = false                                           // Path to existing FASTA file to use as a reference
    map_reads = false                                       // Path to a folder containing reads or a text file with path(s) to read-containing directories to map onto the reference
    bam_files = false                                       // Path to a folder containing BAMs or a text file with path(s) to BAM files
    raw_parquets = false                                    // Path to a folder containing *_Raw.parquet files or a text file with path(s) to files ending in '_Raw.parquet'
    called_bases = false                                    // Path to a folder containing *_Called.parquet files or a text file with path(s) to files ending in '_Called.parquet'
    joined = false                                          // Path to directory containing joined SNPRS output (Scaffold/Bases/Sites/Codes)
    filtered = false                                        // Path to directory containing filtered SNPRS output (Scaffold/Bases/Sites/Codes/alignment/json)
    fixed = false                                           // Path to a file containing paths to 2+ fixed parquet files

    ///// Requested Actions /////

    pangenome = false                                       // Stop at pangenome preparation
    validate = false                                        // Run pangenome validation (and assembly if required)
    convert = false                                         // Stop after converting BAM to raw parquet (requires BAM files or their antecedents)
    call = false                                            // Stop after calling bases (requires raw parquet files or their antecedents)
    join = false                                            // Stop after joining called bases (requires 2+ called base files or their antecedents)
    filter = false                                          // Stop after filtering (requires a joined analysis or its antecedents)
    tree = false                                            // Generate tree after filtering
    get_fixed = false                                       // Get fixed sites for samples or groups designated by --fixed_groups (requires --joined or a full join analysis beforehand)
    refine_fixed = false                                    // Add samples to a fixed site analysis and update output (Requires --fixed; Any upstream BAMs or parquets will be merged into the analysis noted by --fixed in a new subdirectory)

    ///// Filetype Defaults /////

    pg_ext = "fastq.gz"
    pg_forward = "_1.fastq.gz"
    pg_reverse = "_2.fastq.gz"

    map_ext = "fastq.gz"
    map_forward = "_1.fastq.gz"
    map_reverse = "_2.fastq.gz"

    ///// Pangenome Assembly /////
    
    pg_name = false                                         // Pangenome ID
    ray_module = false                                      // Module name for Ray
    size = false                                            // Approximate size of genome for the group in basepairs (bp)
    coverage = 10                                           // Desired read coverage for assembly
    kmer = 31                                               // kmer value for Ray assembly
    out_prop = 0.15                                         // Proportion of reads to take from outgroups, if present

    ///// BAM to Parquet Settings /////

    mapq = 15                                               // Minimum mapping quality (MAPQ) for mpileup -q [Default: 15]
    baseq = 15                                              // Minimum base quality (BASEQ) for mpileup -Q [Default: 15]
    adj_coef = 50                                           // Adjustment coefficient for mpileup -C [Default: 50]

    ///// Base Calling Settings /////

    min_read = 1                                            // Minimum read coverage to consider a site
    min_allele = 1                                          // Minimum read coverage to consider an allele (overrides min_read)
    min_freq = 0.1                                          // Minimum allele frequency to call a secondary allele
    ploidy = 2                                              // Reject sites with too many alleles occurring at or above 'min_freq'

    ///// Join Settings /////
    
    join_id = false                                         // Prefix for joined files [Default: Joined_SNPRS_{timestamp}]

    ///// Filter Settings /////
    
    filter_id = false                                       // Prefix for post-filtered files [Default: Filter_SNPRS_{timestamp}]
    missing = false                                         // If > 1, number of samples with missing data allowed. If < 1, proportion of samples with data required to keep a site. If unset, a missing value is chosen based on the data
    site_types = false                                      // String of single letter codes for sites requested: F/f: Fixed; B/b: Biallelic; T/t: Triallelic; Q/q: Quadallelic; P/p: Pentallellic; S/s: Singleton-only [Default: 'btqp']
    gaps = false                                            // If flagged, retain sites where 1+ sample has '-' [Default: Remove sites with indels]
    het = false                                             // If flagged, retain sites where 1+ sample has a heterozygous call [Default: Remove sites with heterozygous calls]
    invalid = false                                         // If flagged, retain sites where 1+ sample has an invalid call [Default: Remove sites with invalid calls]
    nosing = false                                          // If flagged, remove sites with singletons [Default: Allow singletons if other criteria are met]

    ///// Tree Settings /////

    gtr = false                                             // Use GTR+G for iqtree [Default: MFP+MERGE]
    bb = 1000                                               // Ultrafast bootstrap replicates [Default: 1000]
    fast = false                                            // Use fasttree instead of iqtree [Default: iqTree except for validation mode]

    ///// Fixed Groups /////
    
    fixed_groups = false                                    // Path to a file containing (1) a list of sample IDs to group together or (2) a no-header 2-column TSV/CSV with Sample_ID,Fixed_ID (Requires --joined or a full join beforehand)
    allow_missing = false                                   // Samples allowed to have missing (but not contradictory) data. Either a path to a file containing (1) a list of sample IDs or (2) a no-header 2-column TSV/CSV with Sample_ID,Fixed_ID [Default: No samples allowed missing]
    fixed_id = false                                        // Prefix for fixed files [Default: Fixed_SNPRS_{timestamp}]
    refine_id = false                                       // Prefix for refined files [Default: Refined_SNPRS_{timestamp}]
}   