/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SNPRS Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Import profile settings
includeConfig "${projectDir}/conf/profiles.config"

// Global default params
params {
    
    // SNPRS can run in the following run-modes:
    runmode = ""

    // Set name for output folder/file prefixes
    out = "SNPRS_${new java.util.Date().getTime()}"

    // Pangenome read location information
    pg_reads = ""
    pg_name = "${new java.util.Date().getTime()}"
    pg_path = ""
    
    pg_size = 1
    pg_coverage = 10

    // Mapping read location information
    map_reads = ""

    // Read format information
    readext = "fastq.gz"
    forward = "_1.fastq.gz"
    reverse = "_2.fastq.gz"

    // CPU/Node info
    cores = 1
    nodes = 1

    // Ray assembler
    ray_kmer = 31
}
