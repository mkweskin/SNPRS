/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SNPRS Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Import profile settings
includeConfig "${projectDir}/conf/profiles.config"

process {
  conda.enabled = true
  conda.useMicromamba = true
  conda.cacheDir = "${projectDir}/SNPRS_env"
  process.conda = "${projectDir}/conf/SNPRS.yaml"    
}

// Global default params
params {
    
    // Timestamp to use in the event of blanks
    timestamp = "${new java.util.Date().getTime()}"

    // SNPRS can run in the following run-modes:
    runmode = ""

    // Path to overall working directory
    out = ""

    ///// PANGENOME SETTINGS /////
    ray_module = "ray/2.3.1" // Module name for Ray
    pg_reads = "" // Path to directory containing reads or nested dirs
    size = "" // Approximate size of genome for the group in basepairs (bp)
    pg_out = "" // Output directory for pangenome
    pg_name = "" // ID for pangenome
    coverage = 10 // Desired read coverage for assembly
    kmer = 31 // kmer value for Ray assembly
    out_prop = 0.15 // Proportion of reads to take from outgroups, if present
    fasta = "" // If fasta already exists

    pg_ext = "fastq.gz"
    pg_forward = "_1.fastq.gz"
    pg_reverse = "_2.fastq.gz"

    ///// MAPPING SETTINGS /////
    map_reads = "" // Path to a folder containing reads or a text file with path(s) to read-containing directories
    map_ext = "fastq.gz"
    map_forward = "_1.fastq.gz"
    map_reverse = "_2.fastq.gz"

    mapper = "bb" //Read Mapper: bb: BBMap; bt; Bowtie2; mm: Minimap2 (BBMap only now)
    markdup = false // Mark and remove PCR duplicates prior to base calling (only used with paired data)

    // Pileup filtering
    mapq = 15
    readq = 15

    ///// BASE CALLING SETTINGS /////

    rd = 1 // Read depth; Minimum read depth to consider a site
    ad = 1 // Allele depth; Minimum read depth to consider an allele (overrides rd)
    min_freq = 0.1 // Minimum allele frequency to call a secondary allele
    ploidy = 2 // Reject sites with too many alleles occurring at or above 'min_freq'
    adj_coeff = 50 // mpileup downgrade coefficient
}
